# ═══════════════════════════════════════════════════════════════
# SNEAK STUDIO — Variables de entorno

# ── Servidor 
PORT=3090
NODE_ENV=development

# ── Firebase ──────
# Las claves del cliente de Firebase (apiKey, appId, etc.) son
# semi-públicas por diseño: Firebase las protege con reglas de
# Firestore/Storage y con App Check. Aún así, las centralizamos
# aquí para no hardcodearlas en el código fuente.
FIREBASE_API_KEY=tu_api_key_aqui
FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu_proyecto_id
FIREBASE_STORAGE_BUCKET=tu_proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
FIREBASE_APP_ID=tu_app_id

# ── Supabase 



SUPABASE_URL=https://tu_proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
RECAPTCHA_SITE_KEY=tu_recaptcha_site_key
